extends SceneTree

const CLobbyFlowClass = preload("res://scripts/modes/c_lobby_flow.gd")
const CComponentClass = preload("res://scripts/modes/c_component.gd")
const CBomberAttrClass = preload("res://scripts/objects/cbomber_attr.gd")

func _init() -> void:
	print("[TEST] Running Lobby Flow Mock tests (Task 07)...")

	var flow := CLobbyFlowClass.new()
	assert(not flow.data.is_empty(), "mock_lobby_flow.json must load cleanly")
	assert(flow.get_accounts().size() >= 3, "must have >= 3 mock accounts")
	assert(flow.get_servers().size() >= 2, "must have >= 2 mock servers")

	# 1. Verify all account characters exist in CBomberAttr
	for acc: Dictionary in flow.get_accounts():
		var attr = CBomberAttrClass.get_attr(str(acc.get("selected_char", "")))
		assert(attr != null, "Account char_code must exist in CBomberAttr: %s" % str(acc.get("selected_char", "")))
	print("  [PASS] 1. Accounts & CBomberAttr cross-check")

	# 2. Verify CLobbyStrategy routing per channel (0x6B5F29)
	assert(flow.resolve_create_room_action("ch_td_01")["dialog"] == "create_room", "Normal channel -> create_room")
	assert(flow.resolve_create_room_action("ch_sq_01")["dialog"] == "create_room_stage_clear", "StageClear channel -> create_room_stage_clear")
	assert(flow.resolve_create_room_action("ch_bs_01")["auto_create"] == true and flow.resolve_create_room_action("ch_bs_01")["fixed_component_id"] == CComponentClass.MODE_RPG, "RPG channel -> auto_create RPG Room (17)")
	assert(flow.resolve_create_room_action("ch_dh_01")["dialog"] == "create_room_ladder", "Ladder channel -> create_room_ladder")
	assert(flow.resolve_create_room_action("ch_ct_01")["disabled"] == true, "Winning channel -> manual create disabled")
	print("  [PASS] 2. CLobbyStrategy routing (Normal/StageClear/RPG/Ladder/Winning, 0x6B5F29)")

	# 3. Verify channel mode filter & priority sort (0x6277FC / 0x8EAB5C / 0x8EAE1D)
	var modes: Array[int] = flow.get_channel_creatable_modes("ch_td_01")
	assert(modes.size() >= 10, "ch_td_01 must combine basic + special modes")
	assert(modes[0] == 27 and modes[1] == 0 and modes[2] == 20, "Fixed priority order: 27 -> 0 -> 20 (sub_6277FC), got %s" % str(modes))
	assert(modes.find(11) > modes.find(14), "Hedgehog (11) must sort after StageClear (14) in secondary group (sub_6277FC)")
	print("  [PASS] 3. Channel mode filter & fixed priority sort (0x6277FC)")

	# 4. Verify room join & password guard (Dlg_LB-RoomPw)
	assert(flow.can_join_room(101)["ok"] == true, "Open room 101 must allow join")
	var locked_no_pw: Dictionary = flow.can_join_room(103, "")
	assert(locked_no_pw["ok"] == false and locked_no_pw["need_password"] == true, "Locked room 103 requires password")
	assert(flow.can_join_room(103, "wrong")["ok"] == false, "Wrong password must fail")
	assert(flow.can_join_room(103, "123")["ok"] == true, "Correct password '123' must succeed")
	print("  [PASS] 4. Room join & password validation")

	# 5. Verify create room + build_match_start_payload for Classic (0) & Hedgehog (11)
	assert(CLobbyFlowClass.mode_key_to_component_id("captain") == 12, "captain -> 12")
	assert(CLobbyFlowClass.mode_key_to_component_id("hedgehog") == 11, "hedgehog -> 11")
	assert(CLobbyFlowClass.mode_key_to_component_id("survival") == 10, "survival -> 10")
	assert(CLobbyFlowClass.mode_key_to_component_id("timebomb") == 13, "timebomb -> 13")
	assert(CLobbyFlowClass.mode_key_to_component_id("ai_battle") == 16, "ai_battle -> 16")
	assert(CLobbyFlowClass.mode_key_to_component_id("mon_season2") == 22, "mon_season2 -> 22")
	assert(CLobbyFlowClass.mode_key_to_component_id("super_fighter2") == 21, "super_fighter2 -> 21")
	var host: Dictionary = flow.get_accounts()[0]
	var created: Dictionary = flow.create_room("ch_td_01", "Phong Nhim Moi", "999", CComponentClass.MODE_HEDGEHOG, "Village10", host, 1)
	assert(int(created["component_id"]) == 11 and created["locked"] == true and created["password"] == "999" and int(created["team_arrange"]) == 1, "Created room preserves component_id, password & team_arrange")
	var hh_rooms: Array = flow.get_rooms("ch_td_01", CComponentClass.MODE_HEDGEHOG)
	assert(hh_rooms.size() >= 2, "Filtering by MODE_HEDGEHOG must include existing + newly created room")
	var payload_classic: Dictionary = flow.build_match_start_payload(flow.get_room(101))
	assert(payload_classic["ok"] == true and int(payload_classic["component_id"]) == 0 and payload_classic["players"].size() == 2, "Classic match_start_payload")
	var payload_hh: Dictionary = flow.build_match_start_payload(flow.get_room(102))
	assert(payload_hh["ok"] == true and int(payload_hh["component_id"]) == 11 and payload_hh["map_code"] == "Village10", "Hedgehog match_start_payload")
	var payload_sandbox: Dictionary = flow.build_match_start_payload(flow.get_room(103))
	assert(payload_sandbox["ok"] == true and payload_sandbox["map_code"] == "TestAirship01", "1P sandbox map allowed with 1 team")
	print("  [PASS] 5. CreateRoom & MatchStartPayload for Classic (0), Hedgehog (11), and TestAirship01")

	# 6. Verify CSelectServerStage channel catalog, bar formula (0x8550A7), NEW badge (0x8DAAB7), and eligibility (0x66F70C)
	var vis_tabs: Array = flow.get_channel_tabs()
	assert(vis_tabs.size() == 4, "VN client displays 4 tabs (Novice/Free/Ladder/Special)")
	assert(str(vis_tabs[0]["id"]) == "novice" and str(vis_tabs[1]["id"]) == "free" and str(vis_tabs[2]["id"]) == "ladder" and str(vis_tabs[3]["id"]) == "special", "Exact engine tab order (sub_8585B8)")
	assert(flow.get_channel_tabs(true).size() == 5, "Hidden 5th tab (Event) preserved in catalog")
	assert(CLobbyFlowClass.calc_population_bars(0, 200) == 0, "0 pop -> 0 bars")
	assert(CLobbyFlowClass.calc_population_bars(1, 200) == 1, "1 pop -> 1 bar")
	assert(CLobbyFlowClass.calc_population_bars(100, 200) == 4, "50% pop -> 4 bars (6*100/200+1)")
	assert(CLobbyFlowClass.calc_population_bars(200, 200) == 6, "full pop -> 6 bars")
	assert(CLobbyFlowClass.get_bar_frame_offset(true) == 0 and CLobbyFlowClass.get_bar_frame_offset(false) == 6, "Bar color bank offset (0x854FBC)")
	assert(CLobbyFlowClass.has_new_badge(flow.get_channel("ch_sc_01")) == true, "channel_type 72 has NEW badge (0x8DAAB7)")
	assert(CLobbyFlowClass.has_new_badge(flow.get_channel("ch_td_01")) == false, "normal free channel has no NEW badge")
	assert(CLobbyFlowClass.can_enter_channel(flow.get_channel("ch_td_06"), 15, 1)["ok"] == false, "Full channel blocked")
	assert(CLobbyFlowClass.can_enter_channel(flow.get_channel("ch_ts_01"), 15, 1)["ok"] == true, "Novice level 15 allowed")
	assert(CLobbyFlowClass.can_enter_channel(flow.get_channel("ch_ts_01"), 25, 1)["ok"] == false, "Novice level 25 blocked")
	assert(CLobbyFlowClass.can_enter_channel(flow.get_channel("ch_cb_01"), 15, 1)["ok"] == true, "Super type 72 grade 1 <= 2 allowed")
	assert(CLobbyFlowClass.can_enter_channel(flow.get_channel("ch_cb_01"), 15, 3)["ok"] == false, "Super type 72 grade 3 > 2 blocked (0x66F70C)")
	assert(CLobbyFlowClass.can_enter_channel(flow.get_channel("ch_dh_01"), 5, 1)["ok"] == false, "Ladder min_level 10 blocks level 5")
	assert(CLobbyFlowClass.can_enter_channel(flow.get_channel("ch_dh_01"), 15, 1)["ok"] == true, "Ladder level 15 grade 1 allowed")
	var sp_page: Dictionary = flow.get_tab_channels_page("special", 1)
	assert(sp_page["channels"].size() == 8 and int(sp_page["total_pages"]) == 1, "Special tab page 1 has 8 channels")
	print("  [PASS] 6. CSelectServerStage tabs, CH_Bar_User formula, NEW badge & level/grade guards")

	print("[TEST] ALL LOBBY FLOW MOCK TESTS PASSED!")
	quit(0)
