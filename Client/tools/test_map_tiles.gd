extends SceneTree

const CTileInfoClass = preload("res://scripts/objects/ctile_info.gd")
const CGOTileClass = preload("res://scripts/objects/cgo_tile.gd")
const CGOTileGroundClass = preload("res://scripts/objects/cgo_tile_ground.gd")
const CGOTileFixedClass = preload("res://scripts/objects/cgo_tile_fixed.gd")
const CGOTileStaticClass = preload("res://scripts/objects/cgo_tile_static.gd")
const CGOTileFixedBoxClass = preload("res://scripts/objects/cgo_tile_fixed_box.gd")
const CGOTileMoveAbleBoxClass = preload("res://scripts/objects/cgo_tile_movable_box.gd")
const CGOTilePassableClass = preload("res://scripts/objects/cgo_tile_passable.gd")

func _init() -> void:
	print("[TEST] Running Map Tile Class Hierarchy tests (TV-T1..TV-T5)...")

	# TV-T1: CTileInfo parsing from tile_info.json (0x977FFB)
	assert(CTileInfoClass.get_count() > 3000, "TV-T1: Must load 3,000+ tiles from tile_info.json")
	var box_orange: CTileInfoClass = CTileInfoClass.get_info("Tile00_Box/BoxOrange")
	assert(box_orange != null and box_orange.tile_type == 2 and box_orange.hp == 1 and not box_orange.is_movable and not box_orange.explode_on_break, "TV-T1: BoxOrange mismatch")
	var strong1: CTileInfoClass = CTileInfoClass.get_info("Tile16_Box/StrongBox01")
	assert(strong1 != null and strong1.hp == 5 and strong1.is_movable, "TV-T1: StrongBox01 hp=5 movable=true")
	var strong2: CTileInfoClass = CTileInfoClass.get_info("Tile16_Box/StrongBox02")
	assert(strong2 != null and strong2.hp == 2 and strong2.is_movable, "TV-T1: StrongBox02 hp=2 movable=true")
	var puzzle_unmov: CTileInfoClass = CTileInfoClass.get_info("Tile24_Box/PuzzleUnmovablebox")
	assert(puzzle_unmov != null and puzzle_unmov.hp == 255 and not puzzle_unmov.is_movable, "TV-T1: PuzzleUnmovablebox hp=255")
	var explode_blk: CTileInfoClass = CTileInfoClass.get_info("Tile30_Box/ExplodeBlock01")
	assert(explode_blk != null and explode_blk.hp == 1 and explode_blk.explode_on_break, "TV-T1: ExplodeBlock01 explode_on_break=true")
	var pin5: CTileInfoClass = CTileInfoClass.get_info("Tile30_Box/PinBlock05")
	assert(pin5 != null and pin5.hp == 255 and pin5.is_movable and pin5.spike_dir_mask == 16, "TV-T1: PinBlock05 spike_dir_mask=16")
	print("  [PASS] TV-T1: CTileInfo 52-byte tagged-union parsing (0x977FFB)")

	# TV-T2: CGOTilePassable (0x59F04D / 0x5C10E1 / 0x70F346)
	var herb_tile = CGOTilePassableClass.new()
	herb_tile.init_tile(CTileInfoClass.get_info("Tile00_Passable/Herb00"), 1, 2, 2)
	assert(herb_tile.is_concealing() == true and herb_tile.blocks_movement() == false and herb_tile.blocks_flame() == false, "TV-T2: Herb00 conceal")
	assert(herb_tile.on_flame_hit() == true and herb_tile.tile_active == false, "TV-T2: Herb00 must burn on flame")
	var tent_tile = CGOTilePassableClass.new()
	tent_tile.init_tile(CTileInfoClass.get_info("Tile01_Passable/TentBlue"), 2, 3, 2)
	assert(tent_tile.is_concealing() == true, "TV-T2: TentBlue conceals")
	assert(tent_tile.is_passable_from_dir(0) == false and tent_tile.is_passable_from_dir(1) == true, "TV-T2: TentBlue passable_dirs (0x5C10E1)")
	assert(tent_tile.on_flame_hit() == false and tent_tile.tile_active == true, "TV-T2: TentBlue permanent on flame (0x70F346)")
	var water_tile = CGOTilePassableClass.new()
	water_tile.init_tile(CTileInfoClass.get_info("Tile02_Passble/Icewater00"), 3, 4, 2)
	assert(water_tile.is_concealing() == false and water_tile.on_flame_hit() == false, "TV-T2: Icewater00 transparent & permanent")
	assert(water_tile.blocks_movement() == true and water_tile.is_bomb_passable_from_dir(0) == true and water_tile.blocks_flame() == true, "TV-T2: Icewater00 blocks player/flame, lets bombs pass")
	var pin_tile = CGOTilePassableClass.new()
	pin_tile.init_tile(CTileInfoClass.get_info("Tile16_Passble/PinTile01"), 4, 5, 2)
	assert(pin_tile.detonates_bomb_on_touch() == true and pin_tile.tile_info.draw_under_player == true, "TV-T2: PinTile01 detonates bombs & draws under player")
	var conv_info: CTileInfoClass = CTileInfoClass.get_info("TileConv/ConvRR00")
	assert(conv_info != null and conv_info.is_conveyor and conv_info.conveyor_in_mask == 4 and conv_info.conveyor_out_dir == 2, "TV-T2: ConvRR00 conveyor flags")
	pin_tile.free()
	print("  [PASS] TV-T2: CGOTilePassable (player/bomb/flame dirs, PinTile01, conceal, permanence) & Ground conveyor")

	# TV-T3: CGOTileFixedBox multi-hit, indestructible & explode_on_break (0x5BF6F9 / 0x5BF711 / 0x5BF5BD)
	var box2 = CGOTileFixedBoxClass.new()
	box2.init_tile(strong2, 10, 5, 5)
	assert(box2.on_hit() == false and box2.hp == 1 and box2.hit_flash_ticks == 14, "TV-T3: StrongBox02 hit #1 survives with flash")
	assert(box2.on_hit() == true and box2.hp == 0 and box2.is_broken == true, "TV-T3: StrongBox02 hit #2 breaks")
	var indest = CGOTileFixedBoxClass.new()
	indest.init_tile(puzzle_unmov, 11, 6, 5)
	assert(indest.is_indestructible() == true and indest.on_hit() == false and indest.hp == 255, "TV-T3: hp=255 indestructible (0x5BF6F9)")
	var exp_box = CGOTileFixedBoxClass.new()
	exp_box.init_tile(explode_blk, 12, 7, 5)
	var exploded_cells: Array[Vector2i] = []
	exp_box.explode_requested.connect(func(c: int, r: int) -> void: exploded_cells.append(Vector2i(c, r)))
	assert(exp_box.on_hit() == true, "TV-T3: ExplodeBlock01 breaks on 1 hit")
	exp_box.finish_break()
	assert(exploded_cells.size() == 1 and exploded_cells[0] == Vector2i(7, 5), "TV-T3: ExplodeBlock01 emits explode_requested (0x5BF5BD)")
	# Verify multi-hit box state index formulas (sub_5BF1B3 & sub_5BF5BD)
	assert(CGOTileFixedBoxClass.calc_shaken_state_index(1) == 2 and CGOTileFixedBoxClass.calc_shaken_state_index(3) == 4, "TV-T3: shaken state index (0x5BF1B3)")
	assert(CGOTileFixedBoxClass.calc_damaged_state_index(4, 10) == 3 and CGOTileFixedBoxClass.calc_damaged_state_index(1, 10) == 9, "TV-T3: StrongBox01 crack states (0x5BF5BD)")
	assert(CGOTileFixedBoxClass.calc_damaged_state_index(1, 4) == 3, "TV-T3: StrongBox02 crack state (0x5BF5BD)")
	print("  [PASS] TV-T3: CGOTileFixedBox multi-hit, shake/crack states, indestructible & explode_on_break")

	# TV-T4: CGOTileMoveAbleBox push (0x5C0798 / 0x730EF4)
	var mov_box = CGOTileMoveAbleBoxClass.new()
	mov_box.init_tile(strong1, 13, 3, 3)
	assert(mov_box is CGOTileClass and not (mov_box is CGOTileFixedClass), "TV-T4: CGOTileMoveAbleBox inherits CGOTile directly")
	assert(mov_box.can_push() == true, "TV-T4: MoveAbleBox pushable")
	mov_box.push_to(4, 3)
	assert(mov_box.cell == Vector2i(4, 3), "TV-T4: push_to updates cell")
	print("  [PASS] TV-T4: CGOTileMoveAbleBox inheritance & push_to")

	# TV-T5: Full inheritance hierarchy
	var g_tile = CGOTileGroundClass.new()
	var s_tile = CGOTileStaticClass.new()
	assert(g_tile is CGOTileClass, "TV-T5: Ground -> CGOTile")
	assert(s_tile is CGOTileFixedClass and s_tile is CGOTileClass, "TV-T5: Static -> CGOTileFixed -> CGOTile")
	assert(box2 is CGOTileFixedClass and box2 is CGOTileClass, "TV-T5: FixedBox -> CGOTileFixed -> CGOTile")
	assert(herb_tile is CGOTileFixedClass and herb_tile is CGOTileClass, "TV-T5: Passable -> CGOTileFixed -> CGOTile")
	print("  [PASS] TV-T5: Full CGOTile* inheritance hierarchy verified")

	# TV-T6: Conveyor 2-phase center-pull + push-out (0x5BFA43) & visual dir (0x5BFA0A)
	g_tile.init_tile(conv_info, 14, 1, 1)
	assert(conv_info.conveyor_speed_px_per_tick == 2, "TV-T6: ConvRR00 speed is 2 px/tick")
	assert(g_tile.get_visual_dir() == 2, "TV-T6: ConvRR00 visual dir is Right (2)")
	# Phase 1: player left of tile center (x=95 vs anchor 100), in_mask=4 (Right) pulls 2px right, does NOT push out yet
	var s1: Vector2 = CGOTileGroundClass.compute_conveyor_step(Vector2(95, 100), Vector2(100, 100), 2, 4, 2, 0.03)
	assert(is_equal_approx(s1.x, 2.0) and is_equal_approx(s1.y, 0.0), "TV-T6: Phase 1 center-pull 2px/tick")
	# Phase 2: player at tile center (x=100), out_dir=2 pushes 2px right
	var s2: Vector2 = CGOTileGroundClass.compute_conveyor_step(Vector2(100, 100), Vector2(100, 100), 2, 4, 2, 0.03)
	assert(is_equal_approx(s2.x, 2.0) and is_equal_approx(s2.y, 0.0), "TV-T6: Phase 2 push-out 2px/tick")
	# Corner conveyor: in_mask=4 (pull right to center), out_dir=3 (push down once centered)
	var s_corner_in: Vector2 = CGOTileGroundClass.compute_conveyor_step(Vector2(99, 100), Vector2(100, 100), 2, 4, 3, 0.03)
	assert(is_equal_approx(s_corner_in.x, 1.0) and is_equal_approx(s_corner_in.y, 0.0), "TV-T6: Corner pulls to center before turning")
	var s_corner_out: Vector2 = CGOTileGroundClass.compute_conveyor_step(Vector2(100, 100), Vector2(100, 100), 2, 4, 3, 0.03)
	assert(is_equal_approx(s_corner_out.x, 0.0) and is_equal_approx(s_corner_out.y, 2.0), "TV-T6: Corner pushes out_dir once centered")
	print("  [PASS] TV-T6: CGOTileGround conveyor 2-phase center-pull & push-out (0x5BFA43 / 0x5BFA0A)")

	# TV-T7: Directional spike face bitmask (0x7299A8)
	assert(CTileInfoClass.has_spike_for_dir(16, -1) == true and CTileInfoClass.has_spike_for_dir(16, 0) == false, "TV-T7: Omni spike (0x10)")
	assert(CTileInfoClass.has_spike_for_dir(4, 0) == true and CTileInfoClass.has_spike_for_dir(4, 2) == false, "TV-T7: Bomb Left hits Right face (0x04)")
	assert(CTileInfoClass.has_spike_for_dir(8, 1) == true and CTileInfoClass.has_spike_for_dir(8, 3) == false, "TV-T7: Bomb Up hits Down face (0x08)")
	assert(CTileInfoClass.has_spike_for_dir(1, 2) == true and CTileInfoClass.has_spike_for_dir(1, 0) == false, "TV-T7: Bomb Right hits Left face (0x01)")
	assert(CTileInfoClass.has_spike_for_dir(2, 3) == true and CTileInfoClass.has_spike_for_dir(2, 1) == false, "TV-T7: Bomb Down hits Up face (0x02)")
	print("  [PASS] TV-T7: Directional spike face bitmask verified (0x7299A8)")

	# TV-T8: 4-dir passable traversal for player/bomb/flame (0x5C0E98 / 0x5C1030 / 0x5C10E1)
	# TentBlue has [false, true, false, true] (Up/Down open, Left/Right closed)
	assert(CGOTilePassableClass.can_traverse_step(null, tent_tile, 3, 0) == true, "TV-T8: Player enters TentBlue from top (moving Down)")
	assert(CGOTilePassableClass.can_traverse_step(null, tent_tile, 2, 0) == false, "TV-T8: Player blocked entering TentBlue from left (moving Right)")
	assert(CGOTilePassableClass.can_traverse_step(tent_tile, null, 0, 2) == false, "TV-T8: Flame blocked exiting TentBlue Left")
	assert(CGOTilePassableClass.can_traverse_step(tent_tile, null, 1, 2) == true, "TV-T8: Flame passes exiting TentBlue Up")
	# Icewater00 blocks player (mode 0) & flame (mode 2) but lets bombs pass (mode 1)
	assert(CGOTilePassableClass.can_traverse_step(null, water_tile, 2, 0) == false, "TV-T8: Icewater00 blocks player")
	assert(CGOTilePassableClass.can_traverse_step(null, water_tile, 2, 1) == true, "TV-T8: Icewater00 lets bombs pass (0x5C1030)")
	assert(CGOTilePassableClass.can_traverse_step(null, water_tile, 2, 2) == false, "TV-T8: Icewater00 blocks flame")
	print("  [PASS] TV-T8: 4-dir passable traversal (player/bomb/flame) verified (0x5C0E98/0x5C1030/0x5C10E1)")

	# TV-T9: CGOTileStatic custom_static_id capture helpers (0x5C15DF / 0x743780 / 0x7453F6)
	var cap_info := CTileInfoClass.new()
	cap_info.tile_type = 1
	cap_info.custom_static_id = 10105
	s_tile.init_tile(cap_info, 15, 2, 2)
	assert(s_tile.get_custom_static_id() == 10105 and s_tile.is_capturable_static() == true, "TV-T9: 10105 is capturable")
	assert(s_tile.get_captured_sprite_name() == "Tile15_Static/Aft05", "TV-T9: 10105 -> Tile15_Static/Aft05 (0x7453F6)")
	cap_info.custom_static_id = 0
	assert(s_tile.is_capturable_static() == false and s_tile.get_captured_sprite_name() == "", "TV-T9: 0 is non-capturable")
	print("  [PASS] TV-T9: CGOTileStatic custom_static_id capture sprite mapping verified (0x5C15DF/0x7453F6)")

	# TV-T10: CGOTileGround ground traps (0x5BFE98 / 0x89B145 / 0x89B623 / 0x593737 / 0x59E23F)
	g_tile.set_ground_trap(CGOTileGroundClass.TRAP_BANANA, 0)
	assert(g_tile.trap_active and g_tile.trap_type == CGOTileGroundClass.TRAP_BANANA, "TV-T10: Banana trap active")
	assert(CGOTileGroundClass.get_trap_sprite_path(CGOTileGroundClass.TRAP_BANANA) == "Item/BananaGround", "TV-T10: Banana sprite path")
	assert(g_tile.can_trigger_trap(false, false) == true and g_tile.can_trigger_trap(true, false) == false, "TV-T10: Banana skips flying (0x89B145)")
	g_tile.set_ground_trap(CGOTileGroundClass.TRAP_BOND, 0)
	assert(CGOTileGroundClass.get_trap_sprite_path(CGOTileGroundClass.TRAP_BOND) == "Item/BondGround", "TV-T10: Bond sprite path")
	assert(g_tile.can_trigger_trap(false, true) == true and g_tile.can_trigger_trap(true, false) == false, "TV-T10: Bond skips flying")
	g_tile.set_ground_trap(CGOTileGroundClass.TRAP_MINE, 0)
	assert(g_tile.can_trigger_trap(true, false) == true and g_tile.can_trigger_trap(false, true) == false, "TV-T10: Mine skips shielded (0x89B145)")
	g_tile.set_ground_trap(CGOTileGroundClass.TRAP_PUSHPIN, 0)
	assert(g_tile.can_trigger_trap(false, false) == false, "TV-T10: Pushpin skips bombers (0x89B145)")
	g_tile.clear_ground_trap()
	assert(not g_tile.trap_active and g_tile.trap_type == CGOTileGroundClass.TRAP_NONE, "TV-T10: clear_ground_trap")
	# Slide-until-obstacle (0x593737 + 0x59E23F): duration_ticks=0 with can_fit_cb slides until wall/bomb
	const CGOBomberClass = preload("res://scripts/objects/cgo_bomber.gd")
	var bomber := CGOBomberClass.new()
	bomber.setup(0, "P1", "Character/C00", 1, 1, Color.RED)
	bomber.start_ticks = 0
	var start_x: float = bomber.position.x
	var bomb_wall_x: float = start_x + 55.0
	bomber.start_slide(3, 0, func(pos: Vector2, _pid: int) -> bool: return pos.x <= bomb_wall_x)
	assert(bomber.slide_ticks == 999 and bomber.action == "slide_jump", "TV-T10: Banana slide runs until blocked")
	for _i in range(10):
		bomber._on_tick()
	assert(bomber.slide_ticks == 0 and bomber.action == "idle" and is_equal_approx(bomber.position.x, start_x + 50.0), "TV-T10: Slide stops right before obstacle (0x59E23F)")
	bomber.bond_ticks = 400
	assert(bomber.get_effective_speed() == 2, "TV-T10: Bond slow forces speed=2 (0x59EC93 -> 0x599A12)")
	# Item pickup charges (item_attr.json) + deploy consume + HUD slot + self-cell immunity clear on leave (0x59AA2B / 0x5A6244)
	bomber.apply_item("Banana3")
	bomber.apply_item("Item/ItemBond")
	bomber.apply_item("Item/ItemTrap")
	bomber.apply_item("Pin")
	assert(bomber.banana_count == 3 and bomber.bond_count == 3 and bomber.mine_count == 2 and bomber.pushpin_count == 3, "TV-T10: Ground trap item charges")
	assert(bomber.peek_ground_trap() == 4 and bomber.consume_ground_trap(4) and bomber.pushpin_count == 2, "TV-T10: Last-picked trap deploys first")
	var hud: Dictionary = bomber.get_quick_item_hud()
	assert(hud.get("sprite", "") == "Item/Pushpin" and int(hud.get("count", 0)) == 2, "TV-T10: Quick-item HUD reflects active trap")
	var inv_slots: Array[Dictionary] = bomber.get_inventory_slots()
	assert(inv_slots.size() == 6 and int(inv_slots[3].count) == 3 and int(inv_slots[4].count) == 3 and int(inv_slots[5].count) == 2, "TV-T10: 6-slot personal inventory counts")
	bomber._placed_trap_cell = bomber.cell
	bomber.position.x += 40.0
	bomber._update_grid_cell()
	assert(bomber._placed_trap_cell == Vector2i(-1, -1), "TV-T10: Self-trap immunity clears on leaving cell (0x5A6244)")
	bomber.free()
	print("  [PASS] TV-T10: CGOTileGround ground traps (Banana/Bond/Mine/Pushpin) & slide-until-obstacle verified")

	for n in [herb_tile, tent_tile, water_tile, box2, indest, exp_box, mov_box, g_tile, s_tile]:
		n.free()
	CTileInfoClass._by_name.clear()
	print("[TEST] ALL MAP TILE TESTS PASSED!")
	quit(0)
